{
  "name": "esfihadacasa-site",
  "compatibility_date": "2026-09-18",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "triggers": {
    // Uma vez por dia, de madrugada (hora UTC) -- apaga pedidos reais com
    // mais de 13 meses (prazo de conservacao RGPD definido em 2026-10-24).
    "crons": ["0 4 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "esfiha-pedidos",
      "database_id": "4590db9d-7a3c-4722-a0fc-12fb407bf653"
    }
  ]
}
